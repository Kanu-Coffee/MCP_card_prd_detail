# Host paths. Create them with prepare-host-storage.sh before deploying; Compose
# deliberately refuses to create a missing bind source.
CARDRAG_DATA_ROOT=/srv/cardrag/runtime
CARDRAG_IMPORT_ROOT=/srv/cardrag/imports
CARDRAG_ARCHIVE_ROOT=/mnt/cardrag-backup/cardrag
# Exact `findmnt -o SOURCE` value recorded by init-archive-root.sh.
CARDRAG_ARCHIVE_EXPECTED_SOURCE=nas.example:/cardrag
CARDRAG_CONFIG_ROOT=/srv/cardrag/config
CARDRAG_SECRETS_DIR=/srv/cardrag/secrets
CARDRAG_DEPLOYMENT_ROOT=/srv/cardrag/config/deployment

# REQUIRED for customer-facing HTTPS. Replace the reserved example host with
# the same public Keycloak origin in both values; only the issuer adds the
# realm suffix. Leaving these examples unchanged is not a live configuration.
KEYCLOAK_PUBLIC_URL=https://auth.cardrag.example
CARDRAG_OIDC_ISSUER=https://auth.cardrag.example/realms/cardrag
# Used only by cardrag-bootstrap-stack.yaml and removed after first login.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=cardrag-bootstrap

# Fresh installs use these explicit external volumes. Existing installs must set
# the names printed by discover-legacy-volumes.sh; never guess a Stack prefix.
CARDRAG_POSTGRES_VOLUME=cardrag-postgres-v1
CARDRAG_CODEX_AUTH_VOLUME=cardrag-codex-auth-v1

# The normal Stack starts no optional one-shot. Use COMPOSE_PROFILES only for
# `ops` or `legacy-import`; export and restore use their dedicated Stack YAML.
COMPOSE_PROFILES=
CARDRAG_ADMIN_OPERATION_ENABLED=false
# Allow-list: legacy-status, legacy-finalize, run-list, run-bulk, run-daily,
# run-status, run-finalize, job-status, generation-verify, retention-prune. ID
# is mandatory for status, finalize, and generation-verify operations.
CARDRAG_ADMIN_OPERATION=
CARDRAG_ADMIN_OPERATION_ID=
CARDRAG_LEGACY_IMPORT_ENABLED=false
CARDRAG_LEGACY_OPERATION=import
CARDRAG_LEGACY_IMPORT_ID=
CARDRAG_LEGACY_BUNDLE_NAME=READY-NOT-SET
CARDRAG_STATE_EXPORT_ENABLED=false
# Set true only when at least one sealed normalized bundle must be embedded.
CARDRAG_STATE_SELF_CONTAINED=false
CARDRAG_STATE_RESTORE_ENABLED=false
CARDRAG_STATE_PACKAGE_PATH=/mnt/cardrag-archive/READY-NOT-SET

# One-time v0.1.2 schema-13 bridge only. Set an explicit maintenance-window ID,
# enable for the dedicated pre-migration export Stack, then disable permanently.
CARDRAG_SCHEMA13_TRANSITION_ENABLED=false
CARDRAG_SCHEMA13_TRANSITION_ID=READY-NOT-SET
CARDRAG_SCHEMA13_TRANSITION_RESUME=false

# Post-restore validation Stack only. Keep false for read-path checks. Enable
# once with no ID to test rollback, then once with the recorded original current
# generation ID to roll forward again before leaving validation mode.
CARDRAG_VALIDATION_ROLLBACK_ENABLED=false
CARDRAG_VALIDATION_ROLLBACK_GENERATION_ID=

# Mutation admission gates. Import/export is rejected when any destination is
# below these limits.
CARDRAG_MINIMUM_FREE_GIB=50
CARDRAG_MINIMUM_FREE_PERCENT=20
CARDRAG_MAXIMUM_USED_PERCENT=85
CARDRAG_WARNING_USED_PERCENT=70

# Set an explicit ID before a named-volume migration. Leave resume false on the
# first attempt; change it to true only when retrying that same marker-owned ID.
CARDRAG_STORAGE_MIGRATION_ID=
CARDRAG_STORAGE_MIGRATION_RESUME=false

# Required release images. Set these only after 0.2.0 is published and prefer
# digest-qualified references (`repository@sha256:...`). Empty values fail Stack
# rendering instead of silently pulling a release that does not exist yet.
CARDRAG_ADMIN_IMAGE=
CARDRAG_WORKER_IMAGE=
CARDRAG_MCP_IMAGE=
