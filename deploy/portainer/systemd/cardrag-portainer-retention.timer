[Unit]
Description=Run Portainer CardRAG retention at 04:00 Asia/Seoul
Documentation=file:/opt/cardrag/deploy/portainer/RUNBOOK.md

[Timer]
OnCalendar=*-*-* 04:00:00 Asia/Seoul
Persistent=true
AccuracySec=5min
RandomizedDelaySec=0
Unit=cardrag-portainer-retention.service

[Install]
WantedBy=timers.target
