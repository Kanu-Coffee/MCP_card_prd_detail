# Copy values to /etc/cardrag/worker.env and /etc/cardrag/mcp.env as appropriate.
# Never commit real credentials. Docker Compose's compose.secrets.yaml overlays are recommended.
CARDRAG_ENVIRONMENT=production
CARDRAG_CHANNEL=stable
# Fail-closed v1.0.10 stable publication gate. Do not enable before cutover approval.
CARDRAG_STABLE_PUBLICATION_APPROVED=false
# Separate shared OCR-cache mutation capability; candidate must keep false/read-only.
CARDRAG_OCR_CACHE_PUBLICATION_APPROVED=false
CARDRAG_ENABLED_ISSUERS=woori,kb,shinhan,samsung
# Since v1.0.6, Shinhan uses the verified official mobile disclosure endpoint
# for the rotating download token. Legacy search terms are bounded and a
# bounded current-category lookup is used only on an index miss, while the
# complete stable desktop listing identity is retained.
# Pin immutable release tags in production; the defaults build local images.
# Keep the immutable v1.0.9 tags in stable until the v1.0.10 candidate and cutover gates pass.
# CARDRAG_WORKER_IMAGE=ymtop59/mcp-card-prd-detail:1.0.9-worker
# CARDRAG_MCP_IMAGE=ymtop59/mcp-card-prd-detail:1.0.9-mcp
# Explicit Compose volume names make candidate isolation and promotion auditable.
# CARDRAG_WORKER_STATE_VOLUME=cardrag-worker-v110-state
# CARDRAG_MCP_STATE_VOLUME=cardrag-mcp-v110-state

# v5 Worker local-capacity policy. The first four limits gate projected state
# and artifacts; the startup floor is checked before provider/WebDAV work.
CARDRAG_WORKER_MAX_STATE_BYTES=68719476736
CARDRAG_WORKER_RESERVED_FREE_SPACE_BYTES=2147483648
CARDRAG_WORKER_MAX_VECTOR_SIDECAR_BYTES=17179869184
CARDRAG_WORKER_MAX_SERVING_DATABASE_BYTES=4294967296
# Change this active value to 34359738368 in candidate Worker env files.
CARDRAG_WORKER_MINIMUM_START_FREE_BYTES=2147483648

CARDRAG_WEBDAV_BASE_URL=https://webdav.example/cardrag
CARDRAG_WEBDAV_USERNAME_SECRET_FILE=/etc/cardrag/secrets/webdav_username
CARDRAG_WEBDAV_PASSWORD_SECRET_FILE=/etc/cardrag/secrets/webdav_password
# Add compose.ca.yaml and set this host path when a private CA is required.
# CARDRAG_WEBDAV_CA_SECRET_FILE=/etc/cardrag/secrets/webdav_ca.pem
# The systemd Worker unit expands this into two Compose arguments.
# CARDRAG_WORKER_COMPOSE_OVERLAYS=--file deploy/worker/compose.ca.yaml
CARDRAG_WEBDAV_CONNECT_TIMEOUT_SECONDS=10
CARDRAG_WEBDAV_TRANSFER_TIMEOUT_SECONDS=600

CARDRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CARDRAG_OPENROUTER_API_KEY_SECRET_FILE=/etc/cardrag/secrets/openrouter_api_key
CARDRAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
CARDRAG_EMBEDDING_DIMENSION=4096
CARDRAG_EMBEDDING_PROVIDER_ID=deepinfra
CARDRAG_EMBEDDING_MAXIMUM_TOKENS=32768
CARDRAG_EMBEDDING_MAX_RESPONSE_BYTES=33554432
CARDRAG_EMBEDDING_METADATA_MAX_RESPONSE_BYTES=2097152
CARDRAG_OCR_PROVIDER=codex-exec
CARDRAG_OCR_MODEL=gpt-5.6-sol
CARDRAG_OCR_REASONING_EFFORT=high
CARDRAG_OCR_PROVIDER_TIMEOUT_SECONDS=1800
CARDRAG_OCR_CACHE_MODE=read-only
CARDRAG_OCR_CACHE_EPOCH=0
CARDRAG_OCR_PROMPT_VERSION=cardrag-ocr.ko.v2
CARDRAG_OCR_RENDER_SCALE_MILLI=6000
CARDRAG_OCR_WHOLE_DOCUMENT_MAX_PAGES=4
CARDRAG_OCR_CHUNK_PAGES=2
CARDRAG_OCR_CONTEXT_PAGES_BEFORE=1
CARDRAG_OCR_CONTEXT_PAGES_AFTER=1
# v1.0.9 isolates exhausted document OCR failures. It embeds successful
# documents only when every issuer reaches 95 percent success and exposes
# failed products as ocr_failed. Systemic OCR/embedding failures still stop
# the run. The prompt and native OCR processor contract remain unchanged.
# OCR fallback remains disabled. Keep the v1.0.4 native OCR cache contract so
# verified completed artifacts remain reusable, and leave both
# CARDRAG_OCR_FALLBACK_* variables unset.
CARDRAG_STAGE_MAX_ATTEMPTS=4
CARDRAG_RETRY_CAP_SECONDS=30
CARDRAG_PDF_CACHE_REFRESH_HOURS=168
CARDRAG_RETAIN_GENERATIONS=2
CARDRAG_RETAIN_INCOMPLETE_RUNS=2
CARDRAG_GARBAGE_GRACE_DAYS=30
# Remote deletion is a separate release action from stable publication.
CARDRAG_REMOTE_GC_APPROVED=false
CARDRAG_COLLECT_REMOTE_GARBAGE=false

CARDRAG_MCP_BEARER_TOKEN_SECRET_FILE=/etc/cardrag/secrets/mcp_bearer_token
CARDRAG_MCP_BIND_ADDRESS=127.0.0.1
CARDRAG_MCP_PUBLISHED_PORT=8000
# Public HTTPS origin used in get_source_pdf descriptors.
CARDRAG_MCP_PUBLIC_BASE_URL=https://cardrag.example
CARDRAG_MCP_UPDATE_INTERVAL_SECONDS=300
# v1-v4 inline cap; retained as the resident-cap fallback for compatibility.
CARDRAG_MCP_MAX_VECTOR_BYTES=1073741824
# v5 mmap file bytes and actual heap-resident vector bytes have separate caps.
CARDRAG_MCP_MAX_VECTOR_SIDECAR_BYTES=17179869184
CARDRAG_MCP_MAX_RESIDENT_VECTOR_BYTES=1073741824
CARDRAG_MCP_MAX_SERVING_DATABASE_BYTES=4294967296
CARDRAG_MCP_MAX_GENERATION_DOWNLOAD_BYTES=34359738368
CARDRAG_MCP_MAX_STATE_BYTES=68719476736
CARDRAG_MCP_RESERVED_FREE_SPACE_BYTES=2147483648
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_JOBS=32
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_TOTAL_BYTES=2147483648
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_ARTIFACT_BYTES=268435456
CARDRAG_MCP_RERANKER_AUDIT_MAX_JOBS=1024
CARDRAG_MCP_RERANKER_AUDIT_MAX_TOTAL_BYTES=536870912
CARDRAG_MCP_RERANKER_AUDIT_MAX_ARTIFACT_BYTES=8388608
CARDRAG_MCP_RETAIN_GENERATIONS=2
CARDRAG_MAXIMUM_CANDIDATE_COUNT=250
CARDRAG_MAXIMUM_PDF_BYTES=104857600
CARDRAG_EMBEDDING_TIMEOUT_SECONDS=60
CARDRAG_EMBEDDING_MAX_RESPONSE_BYTES=1048576
CARDRAG_RERANKER_SHADOW_ENABLED=false
CARDRAG_RERANKER_SHADOW_MODEL=qwen/qwen3-reranker-8b
CARDRAG_RERANKER_SHADOW_PROVIDER_ID=fireworks
CARDRAG_RERANKER_SHADOW_MAX_CANDIDATES=64
CARDRAG_RERANKER_SHADOW_TIMEOUT_SECONDS=60
CARDRAG_RERANKER_SHADOW_MAX_RESPONSE_BYTES=1048576
CARDRAG_EXPERIMENTAL_MAP_REDUCE_ENABLED=false
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_INPUT_CHARACTERS=262144
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_COMPLETION_TOKENS=4096
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_JOB_PROVIDER_CALLS=4096
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_JOB_INPUT_CHARACTERS=268435456
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_JOB_OUTPUT_TOKENS=16777216
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_CONCURRENT_PROVIDER_CALLS=1
CARDRAG_EXPERIMENTAL_MAP_REDUCE_TIMEOUT_SECONDS=120
CARDRAG_EXPERIMENTAL_MAP_REDUCE_MAX_RESPONSE_BYTES=1048576

# Candidate-only files should override the values below and add both
# compose.candidate.yaml overlays. Never put these values in stable env files.
# CARDRAG_CANDIDATE_WEBDAV_BASE_URL=https://webdav.example/cardrag-v110-candidate
# CARDRAG_CANDIDATE_MCP_PUBLIC_BASE_URL=https://candidate-cardrag.example
# CARDRAG_CANDIDATE_MCP_BIND_ADDRESS=127.0.0.1
# CARDRAG_CANDIDATE_MCP_PUBLISHED_PORT=18010
# CARDRAG_V109_WORKER_STATE_VOLUME=cardrag-worker-v109-state
# Candidate Worker default; replace the active 2 GiB startup floor above.
# CARDRAG_WORKER_MINIMUM_START_FREE_BYTES=34359738368
# Set true only in candidate-v1.0.10 MCP env after the sealed provider preflight.
# CARDRAG_RERANKER_SHADOW_ENABLED=true
# Set all four only after the reasoning profile wins the bound gold evaluation.
# CARDRAG_EXPERIMENTAL_MAP_REDUCE_ENABLED=true
# CARDRAG_EXPERIMENTAL_MAP_REDUCE_MODEL=openai/replace-with-sealed-model
# CARDRAG_EXPERIMENTAL_MAP_REDUCE_PROVIDER_ID=replace-with-sealed-provider
# CARDRAG_EXPERIMENTAL_MAP_REDUCE_EVALUATION_SHA256=replace-with-64-lowercase-hex
