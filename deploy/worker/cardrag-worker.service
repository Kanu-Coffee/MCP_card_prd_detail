[Unit]
Description=Run the one-shot CardRAG Worker
Documentation=file:/opt/cardrag/current/docs/SIMPLE_RUNTIME.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cardrag/worker.env
ConditionPathExists=/opt/cardrag/current/operations/worker-compose.sh

[Service]
Type=oneshot
User=cardrag
SupplementaryGroups=docker
WorkingDirectory=/opt/cardrag/current
# Always use the active release's verified runtime helper. Direct compose here
# would bypass the private overlay and can select a candidate image/state/auth
# volume instead of the release that was validated for manual operation.
ExecStartPre=/opt/cardrag/current/operations/worker-compose.sh config --quiet
ExecStart=/opt/cardrag/current/operations/worker-compose.sh run --rm --no-deps worker run
TimeoutStartSec=infinity
# The Worker coalesces repeated stop signals and releases its lock only after
# cancellation-fenced mutations and publication reconciliation finish. A
# verified generation can require many individually bounded WebDAV transfers,
# so systemd must not impose a shorter, unsafe aggregate deadline.
KillSignal=SIGTERM
TimeoutStopSec=infinity
SendSIGKILL=no
SuccessExitStatus=130 143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cardrag-worker
UMask=0077
