[Unit]
Description=Run the one-shot CardRAG Worker
Documentation=file:/opt/cardrag/current/docs/SIMPLE_RUNTIME.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cardrag
SupplementaryGroups=docker
WorkingDirectory=/opt/cardrag/current
Environment=CARDRAG_WORKER_COMPOSE_OVERLAYS=
EnvironmentFile=/etc/cardrag/worker.env
ExecStartPre=/usr/bin/docker compose --env-file /etc/cardrag/worker.env --file deploy/worker/compose.yaml --file deploy/worker/compose.secrets.yaml $CARDRAG_WORKER_COMPOSE_OVERLAYS config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/cardrag/worker.env --file deploy/worker/compose.yaml --file deploy/worker/compose.secrets.yaml $CARDRAG_WORKER_COMPOSE_OVERLAYS run --rm worker run
TimeoutStartSec=infinity
# The Worker coalesces repeated stop signals and releases its lock only after
# cancellation-fenced mutations and publication reconciliation finish. A
# verified generation can require many individually bounded WebDAV transfers,
# so systemd must not impose a shorter, unsafe aggregate deadline.
KillSignal=SIGTERM
TimeoutStopSec=infinity
SendSIGKILL=no
SuccessExitStatus=130 143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cardrag-worker
UMask=0077
