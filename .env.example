# Raw process/container contract. Compose operators should instead start from
# deploy/simple.env.example, whose *_SECRET_FILE values name host files.
# Shared WebDAV account. Prefer the _FILE variants in containers.
CARDRAG_ENVIRONMENT=production
CARDRAG_WEBDAV_BASE_URL=https://webdav.example/cardrag
CARDRAG_WEBDAV_USERNAME_FILE=/run/secrets/webdav_username
CARDRAG_WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password
# CARDRAG_WEBDAV_CA_FILE=/run/secrets/webdav_ca.pem
CARDRAG_WEBDAV_CONNECT_TIMEOUT_SECONDS=10
CARDRAG_WEBDAV_TRANSFER_TIMEOUT_SECONDS=600

# Worker: one publisher, current documents only.
CARDRAG_WORKER_STATE_DIR=/var/lib/cardrag-worker
CARDRAG_ENABLED_ISSUERS=woori,kb
# Shinhan remains registered. Re-add `shinhan` only after its official endpoint is verified
# to return current PDF bytes instead of the service-error HTML observed on 2026-08-26.
CARDRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CARDRAG_OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
CARDRAG_EMBEDDING_MODEL=openai/text-embedding-3-small
CARDRAG_EMBEDDING_DIMENSION=1536
CARDRAG_OCR_PROVIDER=codex-exec
CARDRAG_OCR_MODEL=gpt-5.4
CARDRAG_OCR_REASONING_EFFORT=high
CARDRAG_OCR_CACHE_EPOCH=0
CARDRAG_OCR_PROMPT_VERSION=cardrag-ocr.ko.v1
CARDRAG_OCR_CHUNK_PAGES=2
# CARDRAG_OCR_FALLBACK_PROVIDER=openrouter
# CARDRAG_OCR_FALLBACK_MODEL=openai/gpt-5.4
CARDRAG_STAGE_MAX_ATTEMPTS=4
CARDRAG_RETRY_CAP_SECONDS=30
CARDRAG_CODEX_EXECUTABLE=/usr/local/bin/codex
CARDRAG_CODEX_AUTH_ROOT=/var/lib/cardrag-worker/codex

# MCP: loopback behind a TLS reverse proxy.
CARDRAG_MCP_STATE_DIR=/var/lib/cardrag-mcp
CARDRAG_MCP_HOST=127.0.0.1
CARDRAG_MCP_PORT=8000
CARDRAG_MCP_PUBLIC_BASE_URL=https://cardrag.example
CARDRAG_MCP_BEARER_TOKEN_FILE=/run/secrets/mcp_bearer_token
CARDRAG_MCP_UPDATE_INTERVAL_SECONDS=300
CARDRAG_MCP_MAX_VECTOR_BYTES=1073741824
CARDRAG_MCP_RETAIN_GENERATIONS=3
CARDRAG_MAXIMUM_CANDIDATE_COUNT=250
CARDRAG_MAXIMUM_PDF_BYTES=104857600
CARDRAG_EMBEDDING_TIMEOUT_SECONDS=60
