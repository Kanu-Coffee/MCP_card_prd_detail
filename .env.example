# Raw process/container contract. Compose operators should instead start from
# deploy/simple.env.example, whose *_SECRET_FILE values name host files.
# Shared WebDAV account. Prefer the _FILE variants in containers.
CARDRAG_ENVIRONMENT=production
CARDRAG_CHANNEL=stable
# Keep false through candidate validation; stable publication requires a
# separate, explicit release approval.
CARDRAG_STABLE_PUBLICATION_APPROVED=false
# Separate capability for shared OCR cache writes; never enable for candidate.
CARDRAG_OCR_CACHE_PUBLICATION_APPROVED=false
CARDRAG_WEBDAV_BASE_URL=https://webdav.example/cardrag
CARDRAG_WEBDAV_USERNAME_FILE=/run/secrets/webdav_username
CARDRAG_WEBDAV_PASSWORD_FILE=/run/secrets/webdav_password
# CARDRAG_WEBDAV_CA_FILE=/run/secrets/webdav_ca.pem
CARDRAG_WEBDAV_CONNECT_TIMEOUT_SECONDS=10
CARDRAG_WEBDAV_TRANSFER_TIMEOUT_SECONDS=600

# Worker: one publisher, current documents only.
CARDRAG_WORKER_STATE_DIR=/var/lib/cardrag-worker
# Compose destination for v1.0.11. Never point this at the v1.0.9 operating state volume.
# Stable base default is cardrag-worker-v111-state. The candidate overlay
# deliberately replaces it with cardrag-worker-v112-candidate-state.
# CARDRAG_WORKER_STATE_VOLUME=cardrag-worker-v111-state
# Stable Codex/MCP defaults are the two names below; candidate overlays replace
# them with cardrag-worker-v112-candidate-codex-home and
# cardrag-mcp-v112-candidate-state respectively.
# CARDRAG_WORKER_CODEX_HOME_VOLUME=cardrag-worker-v111-codex-home
# CARDRAG_MCP_STATE_VOLUME=cardrag-mcp-v111-state
# v5 generation planning separately caps complete Worker state, the sealed
# vector sidecar, the sealed serving DB, and free space reserved after peak writes.
CARDRAG_WORKER_MAX_STATE_BYTES=137438953472
CARDRAG_WORKER_RESERVED_FREE_SPACE_BYTES=2147483648
CARDRAG_WORKER_MAX_VECTOR_SIDECAR_BYTES=17179869184
CARDRAG_WORKER_MAX_SERVING_DATABASE_BYTES=34359738368
# Checked before provider or WebDAV work. Candidate operators should raise this
# active value to 34359738368 (32 GiB), matching the candidate Compose default.
CARDRAG_WORKER_MINIMUM_START_FREE_BYTES=2147483648
CARDRAG_ENABLED_ISSUERS=woori,kb,shinhan,samsung
# Since v1.0.6, Shinhan's rotating token is refreshed through the official
# mobile disclosure endpoint. Legacy search terms are bounded and a bounded
# current-category lookup is used only when the search index misses. Every
# result is still bound back to the complete stable desktop listing identity.
CARDRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CARDRAG_OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
CARDRAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
CARDRAG_EMBEDDING_DIMENSION=4096
CARDRAG_EMBEDDING_PROVIDER_ID=deepinfra
CARDRAG_EMBEDDING_MAXIMUM_TOKENS=32768
CARDRAG_EMBEDDING_MAX_RESPONSE_BYTES=33554432
CARDRAG_EMBEDDING_METADATA_MAX_RESPONSE_BYTES=2097152
# Retry only transient OpenRouter request failures inside the current batch.
# Permanent 4xx and embedding contract violations remain fail-fast.
CARDRAG_EMBEDDING_REQUEST_MAX_ATTEMPTS=12
CARDRAG_EMBEDDING_RETRY_BASE_SECONDS=1
CARDRAG_EMBEDDING_RETRY_CAP_SECONDS=60
# M0 leaves both values unset and therefore keeps candidate_default/max_child.
# M1 requires both: a canonical passed profile artifact mounted read-only and
# the independently verified SHA-256 of the complete file (including newline).
# CARDRAG_DOCUMENT_AGGREGATION_PROFILE_FILE=/run/cardrag-release-evidence/document-aggregation-profile.json
# CARDRAG_DOCUMENT_AGGREGATION_PROFILE_ARTIFACT_SHA256=<64 lowercase hex>
CARDRAG_OCR_PROVIDER=codex-exec
CARDRAG_OCR_MODEL=gpt-5.6-sol
CARDRAG_OCR_REASONING_EFFORT=high
CARDRAG_OCR_PROVIDER_TIMEOUT_SECONDS=1800
# Candidate and the default deployment may strictly reuse verified remote OCR
# artifacts but never publish or repair shared native-cache control objects.
# Enabling writes requires the stable channel plus the separate
# CARDRAG_OCR_CACHE_PUBLICATION_APPROVED capability. Stable generation
# publication approval is intentionally independent; one-time adoption does not
# grant a stable pointer cutover.
CARDRAG_OCR_CACHE_MODE=read-only
CARDRAG_OCR_CACHE_EPOCH=0
CARDRAG_OCR_PROMPT_VERSION=cardrag-ocr.ko.v2
CARDRAG_OCR_RENDER_SCALE_MILLI=6000
# Products with at most four pages are sent as one ordered OCR call. Longer
# products output two target pages per call with one visual context page each side.
CARDRAG_OCR_WHOLE_DOCUMENT_MAX_PAGES=4
CARDRAG_OCR_CHUNK_PAGES=2
CARDRAG_OCR_CONTEXT_PAGES_BEFORE=1
CARDRAG_OCR_CONTEXT_PAGES_AFTER=1
# v1.0.9 records a bounded safe reason after one document exhausts OCR retries
# and continues the remaining PDFs. Successful documents are embedded only
# when every issuer has at least 95 percent OCR success; failed products remain
# explicitly visible as ocr_failed. Systemic OCR and embedding errors still
# fail the entire run. The native OCR processor contract remains unchanged.
# OCR fallback remains disabled. Keep the v1.0.4 native OCR cache contract so
# verified completed artifacts remain reusable, and leave both
# CARDRAG_OCR_FALLBACK_* variables unset.
CARDRAG_STAGE_MAX_ATTEMPTS=4
CARDRAG_RETRY_CAP_SECONDS=30
# Fresh hits stay local. At this positive finite TTL, validators are rechecked
# conditionally or validatorless sources are downloaded in full.
CARDRAG_PDF_CACHE_REFRESH_HOURS=168
CARDRAG_CODEX_EXECUTABLE=/usr/local/bin/codex
CARDRAG_CODEX_AUTH_ROOT=/var/lib/cardrag-codex-home
CARDRAG_RETAIN_GENERATIONS=2
CARDRAG_RETAIN_INCOMPLETE_RUNS=2
CARDRAG_GARBAGE_GRACE_DAYS=30
# Remote deletion is a separate release action from stable publication.
CARDRAG_REMOTE_GC_APPROVED=false
CARDRAG_COLLECT_REMOTE_GARBAGE=false

# MCP: loopback behind a TLS reverse proxy.
CARDRAG_MCP_STATE_DIR=/var/lib/cardrag-mcp
CARDRAG_MCP_HOST=127.0.0.1
CARDRAG_MCP_PORT=8000
CARDRAG_MCP_PUBLIC_BASE_URL=https://cardrag.example
CARDRAG_MCP_BEARER_TOKEN_FILE=/run/secrets/mcp_bearer_token
CARDRAG_MCP_UPDATE_INTERVAL_SECONDS=300
# Backward-compatible v1-v4 inline-vector cap and resident-cap fallback.
CARDRAG_MCP_MAX_VECTOR_BYTES=1073741824
# v5 mmap file cap is independent from heap-resident legacy matrices/norm arrays.
CARDRAG_MCP_MAX_VECTOR_SIDECAR_BYTES=17179869184
CARDRAG_MCP_MAX_RESIDENT_VECTOR_BYTES=1073741824
# Disk-file, per-generation, whole-state, and physical-free-space gates are independent.
CARDRAG_MCP_MAX_SERVING_DATABASE_BYTES=34359738368
CARDRAG_MCP_MAX_GENERATION_DOWNLOAD_BYTES=68719476736
CARDRAG_MCP_MAX_STATE_BYTES=137438953472
CARDRAG_MCP_RESERVED_FREE_SPACE_BYTES=2147483648
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_JOBS=32
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_TOTAL_BYTES=2147483648
CARDRAG_MCP_EXHAUSTIVE_AUDIT_MAX_ARTIFACT_BYTES=268435456
CARDRAG_MCP_RERANKER_AUDIT_MAX_JOBS=1024
CARDRAG_MCP_RERANKER_AUDIT_MAX_TOTAL_BYTES=536870912
CARDRAG_MCP_RERANKER_AUDIT_MAX_ARTIFACT_BYTES=8388608
CARDRAG_MCP_RETAIN_GENERATIONS=2
CARDRAG_MAXIMUM_CANDIDATE_COUNT=250
CARDRAG_MAXIMUM_PDF_BYTES=104857600
CARDRAG_EMBEDDING_TIMEOUT_SECONDS=60
CARDRAG_EMBEDDING_MAX_RESPONSE_BYTES=1048576
# Candidate-only experiment. Stable rejects true at settings validation.
CARDRAG_RERANKER_SHADOW_ENABLED=false
CARDRAG_RERANKER_SHADOW_MODEL=qwen/qwen3-reranker-8b
CARDRAG_RERANKER_SHADOW_PROVIDER_ID=fireworks
CARDRAG_RERANKER_SHADOW_MAX_CANDIDATES=64
CARDRAG_RERANKER_SHADOW_TIMEOUT_SECONDS=60
CARDRAG_RERANKER_SHADOW_MAX_RESPONSE_BYTES=1048576
