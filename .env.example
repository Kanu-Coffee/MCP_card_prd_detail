CARDRAG_DATABASE_URL=postgresql://cardrag:change-me@postgres:5432/cardrag
CARDRAG_APPLICATION_VERSION=dev
CARDRAG_IMAGE_REVISION=unknown
# Compose overrides the above with role-specific secret files for worker and MCP.
# Never reuse the admin DSN in either runtime container.
CARDRAG_STORAGE_ROOT=/var/lib/cardrag/objects
CARDRAG_GENERATION_ROOT=/var/lib/cardrag/generations
CARDRAG_BUILD_ROOT=/var/lib/cardrag-build
CARDRAG_PAGE_CACHE_ROOT=/var/cache/cardrag-pages
CARDRAG_MCP_SERVER_URL=http://localhost:8000/mcp
CARDRAG_OIDC_ISSUER=http://cardrag-keycloak.localhost:8080/realms/cardrag
CARDRAG_OIDC_AUDIENCE=cardrag-mcp
CARDRAG_REQUEST_TIMEOUT_SECONDS=45
CARDRAG_POSTGRES_STATEMENT_TIMEOUT_SECONDS=40
CARDRAG_POSTGRES_LOCK_TIMEOUT_SECONDS=5
CARDRAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CARDRAG_OPENROUTER_API_KEY_FILE=/run/secrets/openrouter_api_key
CARDRAG_CODEX_BIN=codex
CARDRAG_CODEX_AUTH_ROOT=/run/cardrag-codex
CARDRAG_WORKER_METRICS_ENABLED=true
CARDRAG_WORKER_METRICS_HOST=127.0.0.1
CARDRAG_WORKER_METRICS_PORT=9090
CARDRAG_OCR_MODEL=gpt-5.4
CARDRAG_OCR_FALLBACK_MODEL=google/gemini-2.5-pro
